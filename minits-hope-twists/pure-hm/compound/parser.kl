# parser.kl -- parser combinators and the MiniTS grammar.
#
# Parsers work directly on the source text: there is no lexer. The input
# state is the original source plus a cursor (offset, line, column), so
# backtracking is just "run the other parser on the old Input value".
#
# HOW TO READ THIS FILE
#   Part 1  what a parser IS (a function from Input to Reply)
#   Part 2  the building blocks, one line of grammar each:
#             p q -> bindP/thenP   p | q -> orP   p* -> manyP   p+ -> someP
#             p? -> optionP        p (sep p)* -> sepBy1P   left-assoc ops -> chainl1
#   Part 3  single characters and exact text
#   Part 4  tokens: the same, plus "skip the spaces after" (lexeme)
#   Part 5  number and string literals
#   Parts 6-8  the MiniTS grammar, written as do (bindP) blocks that read like
#             the grammar rules in the spec: one line per piece, top to bottom.
#
# HOW TO READ A do (bindP) BLOCK
#   do (bindP) {
#     keywordP "while";           <- match "while", ignore the result
#     let! cond = exprP;          <- parse an expression, call it cond
#     let! body = blockP stmt;    <- parse a block, call it body
#     pureP (SWhile cond body)    <- the result: the AST built from the pieces
#   }
#   If any line fails, the whole block fails (and orP may try another option).
include "syntax.kl";

# =====================================================================
# Part 1: Parser representation
# =====================================================================

# Input source length offset line column
#   WHERE the parser is in the text. The text itself is never cut up: only
#   the cursor (offset) moves forward. line/column are kept for error messages.
#   makeInput "let x" = Input "let x" 5 0 1 1      (offset 0 = line 1, column 1)
type Input
  = Input String Int Int Int Int;

# ParseError offset line column message
#   Why and where parsing failed, e.g.  ParseError 9 2 1 "expected ';'"
#   showParseError prints it as  "2:1: expected ';'".
type ParseError
  = ParseError Int Int Int String;

# Reply a: what you get back from running a Parser a.
#   POk value rest err   success: the value, the input AFTER the eaten text,
#                        and the furthest error seen along the way
#   PFail err            failure, with where and why
# The "furthest error" is only for good messages: if an alternative failed
# deep inside the text, that position is reported instead of the start.
type Reply a
  = POk a Input ParseError
  | PFail ParseError;

# Parser a: something that can read an `a` from the input.
#   It is just a wrapped function  Input -> Reply a.  runP unwraps it and calls it.
#   charP "x" : Parser String     numberP : Parser Expr     stmtP : Parser Stmt
#
# HOW TO READ THE EXAMPLES IN THIS FILE
#   p on "abc"  =>  ok "a", rest "bc"     p succeeded, produced "a", left "bc"
#   p on "xyz"  =>  fail 1:1 expected 'a' p failed at line 1, column 1
type Parser a
  = Parser (Input -> Reply a);

# runP :: Parser a -> Input -> Reply a
let runP p inp =
  match p {
    Parser f => f inp;
  };

# makeInput :: String -> Input
let makeInput src =
  Input src (str_len src) 0 1 1;

# inputOffset :: Input -> Int
let inputOffset inp =
  match inp {
    Input _ _ off _ _ => off;
  };

# atEnd :: Input -> Bool
let atEnd inp =
  match inp {
    Input _ len off _ _ => off >= len;
  };

# errorAt :: Input -> String -> ParseError
let errorAt inp msg =
  match inp {
    Input _ _ off line col => ParseError off line col msg;
  };

# noError: placeholder "furthest error" that loses to every real error.
let noError =
  ParseError (0 - 1) 0 0 "";

# errOffset :: ParseError -> Int
let errOffset e =
  match e {
    ParseError off _ _ _ => off;
  };

# furthest :: ParseError -> ParseError -> ParseError
#   Keep the error that got further into the input. On a tie keep the
#   later one (it describes what was expected most recently).
let furthest e1 e2 =
  if errOffset e1 > errOffset e2 then e1 else e2;

# showParseError :: ParseError -> String     e.g. "2:7: expected ';'"
let showParseError e =
  match e {
    ParseError _ line col msg =>
      str_join [int_to_string line, ":", int_to_string col, ": ", msg];
  };

# advanceInput :: Input -> String -> Input   (move past one character c)
let advanceInput inp c =
  match inp {
    Input src len off line col =>
      if c == "\n" then
        Input src len (off + 1) (line + 1) 1
      else
        Input src len (off + 1) line (col + 1);
  };

# =====================================================================
# Part 2: Reusable combinators
# =====================================================================

# pureP :: a -> Parser a          (succeed without consuming)
# pureP x : succeed with x and eat nothing.           grammar: (nothing)
#   pureP 5 on "abc"  =>  ok 5, rest "abc"
# Usually the LAST line of a do block, to return the AST you built:
#   pureP (SLet name ann init)
let pureP x =
  Parser (fn inp => POk x inp noError);

# failP :: String -> Parser a     (fail at the current position)
# failP msg : always fail, right here, with msg.
#   failP "nope" on "abc"  =>  fail 1:1 nope
let failP msg =
  Parser (fn inp => PFail (errorAt inp msg));

# bindP :: Parser a -> (a -> Parser b) -> Parser b      (sequencing)
# bindP p k : SEQUENCING.  Run p; if it gives x, run (k x) on what is left.
#   If either part fails, the whole thing fails.          grammar: p q
#   You rarely call it directly. These all mean the same:
#     bindP p (fn x => q)        p `bindP` (fn x => q)        do (bindP) { let! x = p; q }
#   do (bindP) { let! x = charP "a"; let! y = charP "b"; pureP (str_concat y x) }
#     on "abc"  =>  ok "ba", rest "c"
let bindP p k =
  Parser (fn inp =>
    match runP p inp {
      PFail e => PFail e;
      POk x rest e1 =>
        match runP (k x) rest {
          PFail e2 => PFail (furthest e1 e2);
          POk y rest2 e2 => POk y rest2 (furthest e1 e2);
        };
    });

# mapP :: (a -> b) -> Parser a -> Parser b
# mapP f p : run p, then change its result with f. Eats exactly what p eats.
#   mapP (fn d => d == "7") (satisfyP "digit" isDigitChar) on "7x"  =>  ok true, rest "x"
# Typical use, turning matched text into AST:  mapP (fn _ => EBool true) (keywordP "true")
let mapP f p =
  p `bindP` (fn x => pureP (f x));

# thenP :: Parser a -> Parser b -> Parser b      (run p, keep q's result)
# thenP p q : run p, IGNORE its result, then run q and keep q's result.
#   Written  p `thenP` q,  or just  p;  as a line in a do block.
#   charP "(" `thenP` charP "x"  on "(x)"  =>  ok "x", rest ")"
let thenP p q =
  p `bindP` (fn _ => q);

# skipAfter :: Parser a -> Parser b -> Parser a  (run p then q, keep p's result)
# skipAfter p q : run p, then q, but KEEP p's result (q's is ignored).
#   The mirror image of thenP: use it for "this thing, then some junk after it".
#   charP "x" `skipAfter` charP ";"  on "x;y"  =>  ok "x", rest "y"
let skipAfter p q =
  p `bindP` (fn x => q `bindP` (fn _ => pureP x));

# orP :: Parser a -> Parser a -> Parser a
# orP p q : ALTERNATIVES.  Try p; if p fails, try q.         grammar: p | q
#   q starts from the SAME place p started, even if p had already eaten text
#   before failing (this is the "backtracking" the spec asks for).
#   orP (textP "let") (textP "lex")  on "lex"  =>  ok "lex", rest ""
#   orP (textP "let") (textP "lex")  on "lot"  =>  fail 1:1 expected 'lex'
# Order matters: the first alternative that succeeds wins.
let orP p q =
  Parser (fn inp =>
    match runP p inp {
      POk x rest e => POk x rest e;
      PFail e1 =>
        match runP q inp {
          PFail e2 => PFail (furthest e1 e2);
          POk y rest e2 => POk y rest (furthest e1 e2);
        };
    });

# choiceP :: [Parser a] -> Parser a
# choiceP [p1, p2, ...] : orP over a whole list; first one that works wins.
#   grammar: p1 | p2 | ...
#   choiceP [charP "a", charP "b", charP "c"]  on "c"  =>  ok "c", rest ""
letrec choiceP ps =
  match ps {
    [] => failP "no alternative matched";
    p :: [] => p;
    p :: rest => orP p (choiceP rest);
  };

# manyLoop :: Parser a -> Input -> [a] -> ParseError -> Reply [a]
# manyLoop: the loop behind manyP (you never call it yourself).
#   Keeps running p, collecting results, until p fails. It also stops if p
#   succeeds WITHOUT eating anything, otherwise `manyP (pureP x)` would loop forever.
letrec manyLoop p inp acc err =
  match runP p inp {
    PFail e => POk (listReverse acc) inp (furthest err e);
    POk x rest e =>
      if inputOffset rest == inputOffset inp then
        POk (listReverse (x :: acc)) rest (furthest err e)
      else
        manyLoop p rest (x :: acc) (furthest err e);
  };

# manyP :: Parser a -> Parser [a]           (zero or more)
# manyP p : ZERO OR MORE p, collected in a list.               grammar: p*
#   Never fails: no match at all just gives [].
#   manyP (charP "a")  on "aab"  =>  ok ["a", "a"], rest "b"
#   manyP (charP "a")  on "b"    =>  ok [], rest "b"
let manyP p =
  Parser (fn inp => manyLoop p inp [] noError);

# someP :: Parser a -> Parser [a]           (one or more)
# someP p : ONE OR MORE p.                                      grammar: p+
#   someP (charP "a")  on "aab"  =>  ok ["a", "a"], rest "b"
#   someP (charP "a")  on "b"    =>  fail 1:1 expected 'a'
let someP p =
  p `bindP` (fn x => mapP (fn xs => x :: xs) (manyP p));

# optionP :: Parser a -> Parser (Option a)  (optional)
# optionP p : p OR NOTHING. Never fails.                        grammar: p?
#   optionP (charP "a")  on "ab"  =>  ok Some "a", rest "b"
#   optionP (charP "a")  on "b"   =>  ok None, rest "b"
# Used for optional parts, e.g. the ": Type" in  let x: number = 1;
let optionP p =
  orP (mapP (fn x => Some x) p) (pureP None);

# sepBy1P :: Parser a -> Parser s -> Parser [a]   (p (sep p)*)
# sepBy1P p sep : one or more p, separated by sep.       grammar: p (sep p)*
#   The separators are thrown away, only the p results are kept.
#   sepBy1P digit (charP ",")  on "1,2,3)"  =>  ok ["1", "2", "3"], rest ")"
let sepBy1P p sep =
  p `bindP` (fn x => mapP (fn xs => x :: xs) (manyP (sep `thenP` p)));

# sepByP :: Parser a -> Parser s -> Parser [a]    ((p (sep p)*)?)
# sepByP p sep : like sepBy1P but zero items is fine.  grammar: (p (sep p)*)?
#   Used for argument lists, parameter lists and record fields:
#   sepByP digit (charP ",")  on ")"  =>  ok [], rest ")"
let sepByP p sep =
  orP (sepBy1P p sep) (pureP []);

# chainl1 :: Parser a -> Parser (a -> a -> a) -> Parser a
# chainl1 p op : p (op p)*, combined LEFT to RIGHT.   (left-associative operators)
#   op is a parser that returns a FUNCTION that joins two results.
#   With p = numbers and op = "-":   1 - 2 - 3   becomes   (1 - 2) - 3
#   exprP on "1 - 2 - 3"  =>  ok (- (- 1 2) 3)
# Every binary-operator level (multiplication, addition, ...) is one chainl1.
let chainl1 p op =
  p `bindP` (fn first =>
    mapP
      (fn rest => listFoldl (fn acc pr => match pr { Pair f x => f acc x; }) first rest)
      (manyP (op `bindP` (fn f => mapP (fn x => Pair f x) p))));

# notFollowedByP :: Parser a -> String -> Parser Unit
# notFollowedByP p msg : LOOKAHEAD. Succeeds (eating nothing) only if p would FAIL here.
#   notFollowedByP (charP "a") "no a here"  on "b"   =>  ok unit, rest "b"
#   notFollowedByP (charP "a") "no a here"  on "ab"  =>  fail 1:1 no a here
# Used for "let but not letter", "= but not ===", and "no { after =>".
let notFollowedByP p msg =
  Parser (fn inp =>
    match runP p inp {
      POk _ _ _ => PFail (errorAt inp msg);
      PFail _ => POk unit inp noError;
    });

# quietP :: Parser a -> Parser a     (forget p's abandoned-alternative errors)
# quietP p : run p, but forget the "furthest error" it collected.
#   Only wsP uses it, so failed whitespace attempts never show up in error messages.
let quietP p =
  Parser (fn inp =>
    match runP p inp {
      POk x rest _ => POk x rest noError;
      PFail e => PFail e;
    });

# eofP :: Parser Unit                (end-of-input check)
# eofP : succeeds only at the very end of the input.
#   eofP on ""   =>  ok unit
#   eofP on "x"  =>  fail 1:1 expected end of input
let eofP =
  Parser (fn inp =>
    if atEnd inp then POk unit inp noError
    else PFail (errorAt inp "expected end of input"));

# =====================================================================
# Part 3: Character and literal-text parsers
# =====================================================================

# satisfyP :: String -> (String -> Bool) -> Parser String
# satisfyP desc pred : ONE character for which pred is true.
#   desc is used in the error message ("expected <desc>").
#   satisfyP "digit" isDigitChar  on "7x"  =>  ok "7", rest "x"
#   satisfyP "digit" isDigitChar  on "x7"  =>  fail 1:1 expected digit
let satisfyP desc pred =
  Parser (fn inp =>
    match inp {
      Input src len off _ _ =>
        if off >= len then
          PFail (errorAt inp (str_concat "expected " desc))
        else
          let c = str_at src off in
          if pred c then
            POk c (advanceInput inp c) noError
          else
            PFail (errorAt inp (str_concat "expected " desc));
    });

# charP :: String -> Parser String
# charP c : exactly the character c.
#   charP "a"  on "abc"  =>  ok "a", rest "bc"
#   charP "a"  on "xyz"  =>  fail 1:1 expected 'a'
let charP c =
  satisfyP (str_join ["'", c, "'"]) (fn d => d == c);

# advanceText :: Input -> String -> Input   (move past every character of s)
# advanceText inp s : move the cursor past every character of s
#   (one advanceInput per character, so line/column stay right).
let advanceText inp s =
  letrec go i cur =
    if i >= str_len s then cur else go (i + 1) (advanceInput cur (str_at s i))
  in
    go 0 inp;

# textP :: String -> Parser String    (exact literal text)
# textP s : exactly the text s (all characters, in order).
#   textP "==="  on "=== 1"  =>  ok "===", rest " 1"     (spaces are NOT skipped)
let textP s =
  Parser (fn inp =>
    match inp {
      Input src len off _ _ =>
        if off + str_len s <= len then
          (if str_slice src off (off + str_len s) == s then
             POk s (advanceText inp s) noError
           else
             PFail (errorAt inp (str_join ["expected '", s, "'"])))
        else
          PFail (errorAt inp (str_join ["expected '", s, "'"]));
    });

# Character classes (str_ord gives the code point).
let isDigitChar c =
  let o = str_ord c in (o >= 48) && (o <= 57);

let isLetterChar c =
  let o = str_ord c in ((o >= 65) && (o <= 90)) || ((o >= 97) && (o <= 122));

let isIdentStart c =
  isLetterChar c || (c == "_");

let isIdentChar c =
  isIdentStart c || isDigitChar c;

# =====================================================================
# Part 4: Whitespace, comments, and tokens
# =====================================================================

# lineCommentP :: Parser Unit     "//" up to (not including) the line break
# lineCommentP : a // comment, up to but NOT including the line break.
#   lineCommentP on "// hi\nx"  =>  ok unit, rest "\nx"
let lineCommentP =
  do (bindP) {
    textP "//";
    manyP (satisfyP "comment text" (fn c => c != "\n"));
    pureP unit
  };

# wsP :: Parser Unit   spaces, tabs, line breaks and // comments
# wsP : SKIP all spaces, tabs, line breaks and // comments. Never fails.
#   wsP on "  // c\n  x"  =>  ok unit, rest "x"
#   wsP on "x"            =>  ok unit, rest "x"       (nothing to skip is fine)
let wsP =
  quietP
    (mapP (fn _ => unit)
      (manyP
        (orP
          (mapP (fn _ => unit)
            (satisfyP "whitespace" (fn c => (c == " ") || (c == "\t") || (c == "\n") || (c == "\r"))))
          lineCommentP)));

# lexeme :: Parser a -> Parser a   (p, then skip trailing whitespace/comments)
# lexeme p : run p, then skip the whitespace/comments AFTER it.
#   This is why the grammar never mentions spaces: every token parser
#   (symbolP, operatorP, keywordP, identifierP, numberP, stringP) is a lexeme,
#   so each token cleans up the spaces behind itself.
#   lexeme (textP "let")  on "let   x"  =>  ok "let", rest "x"
#   (Spaces BEFORE the very first token are skipped once, by programP.)
let lexeme p =
  p `skipAfter` wsP;

# symbolP :: String -> Parser String   punctuation such as ( ) { } : ; , .
# symbolP s : punctuation such as ( ) { } : ; , .  then skip spaces.
#   symbolP "("  on "(  x"  =>  ok "(", rest "x"
let symbolP s =
  lexeme (textP s);

# operatorP :: String -> Parser String
# operatorP s : an operator, then skip spaces, but ONLY if it is the whole
#   operator (longest match). "=" refuses to be the start of "===" or "=>",
#   and "<" refuses to be the start of "<=".
#   operatorP "="  on "= 1"    =>  ok "=", rest "1"
#   operatorP "="  on "=== 1"  =>  fail 1:2 '=' is not a complete operator here
#   operatorP "="  on "=> x"   =>  fail 1:2 '=' is not a complete operator here
let operatorP text =
  let forbidden =
    if text == "=" then ["=", ">"]
    else if (text == "<") || (text == ">") || (text == "===") || (text == "!==") || (text == "!") then ["="]
    else if (text == "+") || (text == "-") || (text == "*") || (text == "/") then ["="]   # TWIST: not += etc.
    else []
  in
    lexeme
      (textP text `skipAfter`
        (notFollowedByP
          (satisfyP "operator character" (fn c => listContainsString c forbidden))
          (str_join ["'", text, "' is not a complete operator here"])));

# reservedWords: cannot be identifiers, parameter names, or field names.
#   (A twist that adds a keyword, like `for` or `const`, adds it here.)
let reservedWords =
  ["let", "if", "else", "while", "true", "false", "null", "number", "boolean", "string"];

let isReserved w =
  listContainsString w reservedWords;

# identRawP :: Parser String   [A-Za-z_][A-Za-z0-9_]*  (no whitespace skipping)
# identRawP : [A-Za-z_][A-Za-z0-9_]*   (does NOT skip spaces after)
#   identRawP  on "x1 = 2"  =>  ok "x1", rest " = 2"
let identRawP =
  do (bindP) {
    let! c = satisfyP "identifier" isIdentStart;
    let! cs = manyP (satisfyP "identifier character" isIdentChar);
    pureP (str_join (c :: cs))
  };

# keywordP :: String -> Parser String
# keywordP w : the word w, NOT followed by more identifier characters,
#   then skip spaces. That boundary check is why "letter" is not "let".
#   keywordP "let"  on "let x"   =>  ok "let", rest "x"
#   keywordP "let"  on "letter"  =>  fail 1:4 expected 'let'
let keywordP w =
  lexeme
    (textP w `skipAfter`
      (notFollowedByP (satisfyP "identifier character" isIdentChar)
        (str_join ["expected '", w, "'"])));

# identifierP :: Parser String   an identifier that is not a reserved word
# identifierP : an identifier that is NOT a reserved word, then skip spaces.
#   identifierP  on "count = 1"  =>  ok "count", rest "= 1"
#   identifierP  on "while (x)"  =>  fail 1:1 reserved word 'while' cannot be used as an identifier
let identifierP =
  lexeme
    (Parser (fn inp =>
      match runP identRawP inp {
        PFail e => PFail e;
        POk name rest e =>
          if isReserved name then
            PFail (errorAt inp (str_join ["reserved word '", name, "' cannot be used as an identifier"]))
          else
            POk name rest e;
      }));

# =====================================================================
# Part 5: Literals
# =====================================================================

# digitsToFloat :: Float -> [String] -> Float
letrec digitsToFloat acc ds =
  match ds {
    [] => acc;
    d :: rest => digitsToFloat ((acc *. 10.0) +. int_to_float (str_ord d - 48)) rest;
  };

# pow10 :: Int -> Float
letrec pow10 k =
  if k <= 0 then 1.0 else 10.0 *. pow10 (k - 1);

# numberRawP :: Parser Float     [0-9]+(\.[0-9]+)?
# numberRawP : [0-9]+(\.[0-9]+)?  as a Float (no spaces skipped).
#   numberRawP  on "3.25;"  =>  ok 3.25, rest ";"
#   A leading minus is NOT part of the number: -5 is the unary operator - applied to 5.
let numberRawP =
  do (bindP) {
    let! whole = someP (satisfyP "digit" isDigitChar);
    let! frac = optionP (charP "." `thenP` (someP (satisfyP "digit" isDigitChar)));
    pureP
      (match frac {
         None => digitsToFloat 0.0 whole;
         Some ds => (digitsToFloat 0.0 (listAppend whole ds)) /. pow10 (listLength ds);
       })
  };

# numberP :: Parser Expr   (rejects literals that overflow to infinity)
# numberP : a number literal as an Expr, then skip spaces.
#   numberP  on "42 ;"  =>  ok ENum 42, rest ";"
#   Rejects literals so long they overflow to infinity.
let numberP =
  lexeme
    (Parser (fn inp =>
      match runP numberRawP inp {
        PFail e => PFail e;
        POk n rest e =>
          if isFiniteFloat n then POk (ENum n) rest e
          else PFail (errorAt inp "numeric literal does not denote a finite number");
      }));

# escapeChar :: String -> Option String   (the character after a backslash)
let escapeChar d =
  if d == "\"" then Some "\""
  else if d == "\\" then Some "\\"
  else if d == "n" then Some "\n"
  else if d == "r" then Some "\r"
  else if d == "t" then Some "\t"
  else None;

# stringBody :: Input -> Input -> [String] -> Reply String
# stringBody : the loop that reads a string's characters after the opening quote.
#   Decodes \" \\ \n \r \t, rejects unknown escapes and raw line breaks.
#   start is the opening quote's position, used for "unterminated" errors.
letrec stringBody start inp acc =
  match inp {
    Input src len off _ _ =>
      if off >= len then
        PFail (errorAt start "unterminated string literal")
      else
        let c = str_at src off in
        if c == "\"" then
          POk (str_join (listReverse acc)) (advanceInput inp c) noError
        else if (c == "\n") || (c == "\r") then
          PFail (errorAt inp "unescaped line break in string literal")
        else if c == "\\" then
          (if off + 1 >= len then
             PFail (errorAt start "unterminated string literal")
           else
             let d = str_at src (off + 1) in
             match escapeChar d {
               None =>
                 PFail (errorAt inp (str_join ["unknown escape sequence '\\", escapeText d, "'"]));
               Some decoded =>
                 stringBody start (advanceInput (advanceInput inp c) d) (decoded :: acc);
             })
        else
          stringBody start (advanceInput inp c) (c :: acc);
  };

# stringP :: Parser Expr
# stringP : a "..." string literal as an Expr (contents decoded), then skip spaces.
#   stringP  on "\"a\\nb\" x"  =>  ok EStr "a<newline>b", rest "x"
let stringP =
  lexeme
    (Parser (fn inp =>
      match runP (charP "\"") inp {
        PFail e => PFail e;
        POk _ rest _ =>
          match stringBody inp rest [] {
            PFail e => PFail e;
            POk s after e => POk (EStr s) after e;
          };
      }));

# =====================================================================
# Part 6: Types
#   Type ::= PrimitiveType | FunctionType | RecordType
# =====================================================================

# PrimitiveType ::= "number" | "boolean" | "string" | "null"
let primitiveTypeP =
  choiceP [
    mapP (fn _ => TyNumber) (keywordP "number"),
    mapP (fn _ => TyBoolean) (keywordP "boolean"),
    mapP (fn _ => TyString) (keywordP "string"),
    mapP (fn _ => TyNull) (keywordP "null")
  ];

# TypeParameter ::= Identifier ":" Type
let typeParamP ty =
  do (bindP) {
    let! name = identifierP;
    symbolP ":";
    let! t = ty;
    pureP (Pair name t)
  };

# FunctionType ::= "(" TypeParameters? ")" "=>" Type
let functionTypeP ty =
  do (bindP) {
    symbolP "(";
    let! params = sepByP (typeParamP ty) (symbolP ",");
    symbolP ")";
    operatorP "=>";
    let! ret = ty;
    pureP (TyFun params ret)
  };

# TypeField ::= Identifier ":" Type
let typeFieldP ty =
  do (bindP) {
    let! name = identifierP;
    symbolP ":";
    let! t = ty;
    pureP (Pair name t)
  };

# RecordType ::= "{" (TypeField (";" TypeField)* ";"?)? "}"
let recordTypeP ty =
  do (bindP) {
    symbolP "{";
    let! fields =
      orP
        (do (bindP) {
           let! fs = sepBy1P (typeFieldP ty) (symbolP ";");
           optionP (symbolP ";");
           pureP fs
         })
        (pureP []);
    symbolP "}";
    pureP (TyRecord fields)
  };

# typeAt / typeP: the full Type parser.
#   Types contain types, e.g. (f: (x: number) => number) => string. So the
#   sub-parsers get `Parser typeAt` as their `ty` argument: "parse a type here".
#   typeP  on "(x: number) => string"  =>  ok TyFun [x: number] string
#   typeP  on "{ a: number; }"         =>  ok TyRecord [a: number]
letrec typeAt inp =
  runP
    (choiceP [
      primitiveTypeP,
      functionTypeP (Parser typeAt),
      recordTypeP (Parser typeAt),
      failP "expected a type"
    ])
    inp;

let typeP =
  Parser typeAt;

# =====================================================================
# Part 7: Expressions
#   Each precedence level takes `expr` (the full Expr parser) as an
#   argument; exprP below ties the recursive knot.
# =====================================================================

# Parameter ::= Identifier ":" Type
let paramP =
  do (bindP) {
    let! name = identifierP;
    symbolP ":";
    let! t = typeP;
    pureP (Pair name t)
  };

# ArrowFunction ::= "(" Parameters? ")" ":" Type "=>" Expr
#   A body that is a record literal must be parenthesized.
#   exprP  on "(x: number): number => x + 1"  =>  ok (fn [x: number] number (+ x 1))
let arrowP expr =
  do (bindP) {
    symbolP "(";
    let! params = sepByP paramP (symbolP ",");
    symbolP ")";
    symbolP ":";
    let! ret = typeP;
    operatorP "=>";
    notFollowedByP (textP "{") "an arrow body that is a record literal must be parenthesized";
    let! body = expr;
    pureP (EFun params ret body)
  };

# "(" Expr ")"
#   exprP  on "(x) * 2"  =>  ok (* x 2)      (the arrow attempt fails at ")", then this runs)
let parenP expr =
  do (bindP) {
    symbolP "(";
    let! e = expr;
    symbolP ")";
    pureP e
  };

# RecordField ::= Identifier ":" Expr
let recordFieldP expr =
  do (bindP) {
    let! name = identifierP;
    symbolP ":";
    let! e = expr;
    pureP (Pair name e)
  };

# Record ::= "{" (RecordField ("," RecordField)*)? "}"
#   exprP  on "{ a: 1, b: true }"  =>  ok {a: 1, b: true}
let recordP expr =
  do (bindP) {
    symbolP "{";
    let! fields = sepByP (recordFieldP expr) (symbolP ",");
    symbolP "}";
    pureP (ERecord fields)
  };

# Primary ::= ArrowFunction | Number | String | "true" | "false" | "null"
#           | Identifier | "(" Expr ")" | Record
#   ArrowFunction is tried before "(" Expr ")"; orP backtracks if it fails.
let primaryP expr =
  choiceP [
    arrowP expr,
    numberP,
    stringP,
    mapP (fn _ => EBool true) (keywordP "true"),
    mapP (fn _ => EBool false) (keywordP "false"),
    mapP (fn _ => ENull) (keywordP "null"),
    mapP (fn x => EVar x) identifierP,
    parenP expr,
    recordP expr,
    failP "expected an expression"
  ];

# Postfix suffixes, applied in source order.
type Suffix
  = SufCall [Expr]
  | SufField String;

# CallSuffix ::= "(" Arguments? ")"
let callSuffixP expr =
  do (bindP) {
    symbolP "(";
    let! args = sepByP expr (symbolP ",");
    symbolP ")";
    pureP (SufCall args)
  };

# FieldSuffix ::= "." Identifier
let fieldSuffixP =
  do (bindP) {
    symbolP ".";
    let! name = identifierP;
    pureP (SufField name)
  };

# applySuffix :: Expr -> Suffix -> Expr
let applySuffix e suffix =
  match suffix {
    SufCall args => ECall e args;
    SufField name => EField e name;
  };

# Postfix ::= Primary (CallSuffix | FieldSuffix)*
let postfixP expr =
  do (bindP) {
    let! base = primaryP expr;
    let! suffixes = manyP (orP (callSuffixP expr) fieldSuffixP);
    pureP (listFoldl applySuffix base suffixes)
  };

# Unary ::= ("!" | "-") Unary | Postfix
letrec unaryP expr =
  orP
    (do (bindP) {
       let! op = orP (mapP (fn _ => OpNeg) (operatorP "-")) (mapP (fn _ => OpNot) (operatorP "!"));
       let! inner = unaryP expr;
       pureP (EUnary op inner)
     })
    (postfixP expr);

# binOpP :: String -> BinOp -> Parser (Expr -> Expr -> Expr)
let binOpP text op =
  mapP (fn _ => fn l => fn r => EBinary op l r) (operatorP text);

# Multiplication ::= Unary (("*" | "/") Unary)*
let multiplicationP expr =
  chainl1 (unaryP expr) (orP (binOpP "*" OpMul) (binOpP "/" OpDiv));

# Addition ::= Multiplication (("+" | "-") Multiplication)*
let additionP expr =
  chainl1 (multiplicationP expr) (orP (binOpP "+" OpAdd) (binOpP "-" OpSub));

# Comparison ::= Addition (("<" | "<=" | ">" | ">=") Addition)*
let comparisonP expr =
  chainl1 (additionP expr)
    (choiceP [binOpP "<=" OpLe, binOpP ">=" OpGe, binOpP "<" OpLt, binOpP ">" OpGt]);

# Equality ::= Comparison (("===" | "!==") Comparison)*
let equalityP expr =
  chainl1 (comparisonP expr) (orP (binOpP "===" OpEq) (binOpP "!==" OpNeq));

# LogicalAnd ::= Equality ("&&" Equality)*
let logicalAndP expr =
  chainl1 (equalityP expr) (binOpP "&&" OpAnd);

# LogicalOr ::= LogicalAnd ("||" LogicalAnd)*
let logicalOrP expr =
  chainl1 (logicalAndP expr) (binOpP "||" OpOr);

# Assignment ::= Identifier "=" Assignment | LogicalOr
#   Right-associative because the right side is a full Expr (= Assignment).
#   orP backtracks, so "x" is not committed unless "=" also matches.
#
#   TWIST: Identifier ("+=" | "-=" | "*=" | "/=") Assignment is sugar:
#   x += e  becomes  x = x + e   (x is read before e is evaluated, as in JS).
let compoundOpP =
  choiceP [
    mapP (fn _ => Some OpAdd) (operatorP "+="),
    mapP (fn _ => Some OpSub) (operatorP "-="),
    mapP (fn _ => Some OpMul) (operatorP "*="),
    mapP (fn _ => Some OpDiv) (operatorP "/="),
    mapP (fn _ => None) (operatorP "=")
  ];

let assignmentP expr =
  orP
    (do (bindP) {
       let! name = identifierP;
       let! opOpt = compoundOpP;
       let! rhs = expr;
       pureP
         (match opOpt {
            None => EAssign name rhs;
            Some op => EAssign name (EBinary op (EVar name) rhs);
          })
     })
    (logicalOrP expr);

# exprAt / exprP: the knot for the recursive Expr grammar.  Expr ::= Assignment
#   Expressions contain expressions (in parentheses, call arguments, arrow
#   bodies), so every level gets `expr` = "parse a whole expression here".
#   exprP  on "1 + 2 * 3"   =>  ok (+ 1 (* 2 3))         * binds tighter
#   exprP  on "x = y = 1"   =>  ok (= x (= y 1))         = groups to the right
#   exprP  on "-f(1).a"     =>  ok (- (. (call f [1]) a)) postfix before unary
letrec exprAt inp =
  runP (assignmentP (Parser exprAt)) inp;

let exprP =
  Parser exprAt;

# =====================================================================
# Part 8: Statements and programs
# =====================================================================

# stmtsLoop :: Parser Stmt -> Parser a -> String -> Input -> [Stmt] -> Reply [Stmt]
#   Statement* followed by `close` ("}" or end of input).
letrec stmtsLoop stmt close closeDesc inp acc =
  match runP close inp {
    POk _ rest _ => POk (listReverse acc) rest noError;
    PFail e1 =>
      match runP stmt inp {
        POk s rest _ => stmtsLoop stmt close closeDesc rest (s :: acc);
        PFail e2 =>
          if errOffset e2 > errOffset e1 then
            PFail e2
          else
            PFail (errorAt inp (str_concat "expected a statement or " closeDesc));
      };
  };

# Block ::= "{" Statement* "}"
#   stmtP  on "{ let a = 1; }"  =>  ok {(let a 1)}
let blockP stmt =
  do (bindP) {
    symbolP "{";
    let! body = Parser (fn inp => stmtsLoop stmt (symbolP "}") "'}'" inp []);
    pureP (SBlock body)
  };

# LetStmt ::= "let" Identifier TypeAnn? "=" Expr ";"
let letStmtP =
  do (bindP) {
    keywordP "let";
    let! name = identifierP;
    let! ann = optionP (symbolP ":" `thenP` typeP);
    operatorP "=";
    let! init = exprP;
    symbolP ";";
    pureP (SLet name ann init)
  };

# IfStmt ::= "if" "(" Expr ")" Block ("else" Block)?     (no else = else {})
let ifStmtP stmt =
  do (bindP) {
    keywordP "if";
    symbolP "(";
    let! cond = exprP;
    symbolP ")";
    let! thenBlock = blockP stmt;
    let! elseOpt = optionP (keywordP "else" `thenP` (blockP stmt));
    pureP
      (match elseOpt {
         None => SIf cond thenBlock (SBlock []);
         Some elseBlock => SIf cond thenBlock elseBlock;
       })
  };

# WhileStmt ::= "while" "(" Expr ")" Block
let whileStmtP stmt =
  do (bindP) {
    keywordP "while";
    symbolP "(";
    let! cond = exprP;
    symbolP ")";
    let! body = blockP stmt;
    pureP (SWhile cond body)
  };

# ExprStmt ::= Expr ";"    A leading "{" at statement position is a block.
#   stmtP  on "f(1);"  =>  ok (expr (call f [1]))
let exprStmtP =
  do (bindP) {
    notFollowedByP (textP "{") "expected a statement";
    let! e = exprP;
    symbolP ";";
    pureP (SExpr e)
  };

# Statement ::= LetStmt | IfStmt | WhileStmt | Block | ExprStmt
let statementP stmt =
  choiceP [
    letStmtP,
    ifStmtP stmt,
    whileStmtP stmt,
    blockP stmt,
    exprStmtP
  ];

# stmtAt / stmtP: the full Statement parser (statements contain blocks of statements).
#   stmtP  on "let x: number = 5;"            =>  ok (let x: number 5)
#   stmtP  on "if (c) { x = 1; }"             =>  ok (if c {(expr (= x 1))} {})
#   stmtP  on "while (i < 3) { i = i + 1; }"  =>  ok (while (< i 3) {(expr (= i (+ i 1)))})
letrec stmtAt inp =
  runP (statementP (Parser stmtAt)) inp;

let stmtP =
  Parser stmtAt;

# Program ::= Statement* EOF     (whitespace/comments allowed before and after)
let programP =
  do (bindP) {
    wsP;
    let! stmts = Parser (fn inp => stmtsLoop stmtP eofP "end of input" inp []);
    pureP (Program stmts)
  };

# parse :: String -> Result Program ParseError
let parse src =
  match runP programP (makeInput src) {
    POk prog _ _ => Ok prog;
    PFail e => Err e;
  };

# parseExpr :: String -> Result Expr ParseError   (a lone expression; for tests)
let parseExpr src =
  match runP (wsP `thenP` (exprP `skipAfter` eofP)) (makeInput src) {
    POk e _ _ => Ok e;
    PFail e => Err e;
  };
